<!-- Android Auto artwork for the "Heavy Rotation" mix. Mirrors the app's mix card:
     same top-left to bottom-right gradient and the Material "replay" icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
  <path android:pathData="M0,0 L200,0 L200,200 L0,200 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="0"
          android:startY="0"
          android:endX="200"
          android:endY="200"
          android:startColor="#EC4899"
          android:endColor="#BE185D"/>
    </aapt:attr>
  </path>
  <!-- 24dp Material icon scaled to 96 and centred -->
  <group
      android:translateX="52"
      android:translateY="52"
      android:scaleX="4"
      android:scaleY="4">
    <path
        android:fillColor="#E6FFFFFF"
        android:pathData="M12,5V1L7,6l5,5V7c3.31,0 6,2.69 6,6s-2.69,6 -6,6 -6,-2.69 -6,-6H4c0,4.42 3.58,8 8,8s8,-3.58 8,-8 -3.58,-8 -8,-8z"/>
  </group>
</vector>
